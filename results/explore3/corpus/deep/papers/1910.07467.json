    "mechanisms": [
      {
        "mechanism_category": "scale_invariance",
        "method": "norm=rmsnorm",
        "quote": "RMSNorm regularizes the summed inputs to a neuron in one layer according to root mean square (RMS), giving the model re-scaling invariance property and implicit learning rate adaptation ability.",
        "section": "abstract"
      },
      {
        "mechanism_category": "computational_efficiency",
        "method": "norm=rmsnorm",
        "quote": "Our efficiency improvement come from simplifying the computation, and we thus expect them to be orthogonal to other means of increasing training speed, such as low-precision arithmetic and GPU kernel fusion.",
        "section": "conclusion"
      },
      {
        "mechanism_category": "gradient_stability",
        "method": "norm=rmsnorm",
        "quote": "This supports our hypothesis that RMSNorm stabilizes recurrent activations without the need to explicitly normalize the mean.",
        "section": "experimental_setup"
      }
    ],
    "recipes": [],
    "results": [
      {
        "direction": "no_worse",
        "method": "norm=rmsnorm",
        "quote": "RMSNorm achieves BLEU scores comparable to LayerNorm, and yields a speedup of 7% \\sim 9%.",
        "section": "experimental_setup",
        "setting_note": "Transformer base, WMT14 En-De"
      },
      {
        "direction": "no_worse",
        "method": "norm=rmsnorm",
        "quote": "Overall, RMSNorm yields comparable translation quality compared with LayerNorm but incurs less computational overhead, outperforming LayerNorm with speedups ranging from 11% \\sim 34%.",
        "section": "experimental_setup",
        "setting_note": "RNNSearch/Transformer in Theano and PyTorch, translation"
      },
      {
        "direction": "improves",
        "method": "norm=rmsnorm",
        "quote": "both RMSNorm and LayerNorm improve the model performance, reaching higher recall values (except LayerNorm on R@5) and lower mean rank, though RMSNorm reveals better generalization than LayerNorm.",
        "section": "experimental_setup",
        "setting_note": "order-embedding image-caption retrieval, MS COCO"
      },
      {
        "direction": "improves",
        "method": "norm=rmsnorm",
        "quote": "In contrast, RMSNorm shows better generalization, surpassing the Baseline by 0.013% and saving about 20.5% training time compared to LayerNorm.",
